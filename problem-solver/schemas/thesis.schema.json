{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/thesis.schema.json",
  "title": "Problem Thesis Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_id",
    "title",
    "problem_statement",
    "context",
    "object_of_study",
    "central_thesis",
    "primary_question",
    "secondary_questions",
    "hypotheses",
    "scope",
    "constraints",
    "baseline",
    "success_criteria",
    "falsification_criteria",
    "expertise_work_packages",
    "assumptions",
    "unknowns",
    "risk_class",
    "status"
  ],
  "properties": {
    "problem_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 8},
    "problem_statement": {"type": "string", "minLength": 20},
    "context": {"type": "string", "minLength": 1},
    "object_of_study": {"type": "string", "minLength": 1},
    "central_thesis": {"type": "string", "minLength": 20},
    "primary_question": {"type": "string", "minLength": 10},
    "secondary_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "supporting_observations", "disconfirming_observations"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "supporting_observations": {"type": "array", "items": {"type": "string"}},
          "disconfirming_observations": {"type": "array", "items": {"type": "string"}}
        }
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "time_horizon"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "time_horizon": {"type": "string"}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "baseline": {"type": "string"},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "falsification_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "expertise_work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "discipline", "required_method", "deliverable"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "discipline": {"type": "string"},
          "required_method": {"type": "string"},
          "deliverable": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        }
      },
      "minItems": 1
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"type": "string", "enum": ["low", "moderate", "high", "critical", "unclassified"]},
    "status": {"type": "string", "enum": ["draft", "thesis_ready", "blocked", "completed"]}
  }
}
